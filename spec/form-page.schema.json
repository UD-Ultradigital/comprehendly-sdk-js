{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.comprehendly.nz/spec/form-page.schema.json",
  "title": "ComprehendlyFormPage",
  "type": "object",
  "required": ["id", "elements"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "page_title": { "type": ["string", "null"] },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "form_field",
            "form_field_rating",
            "form_field_score",
            "form_tree"
          ]
        },
        "data": { "type": "object" }
      }
    }
  }
}
